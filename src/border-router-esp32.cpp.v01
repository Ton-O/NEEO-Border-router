/* --- Forward Declarations --- */
void addToLog(const char* source, const char* service, const char* msg);
void processAction(const uint8_t* data, size_t len, const char* source, const char* service);
void processIncomingJennic(const uint8_t* data, size_t len);
String getFullLog();
void sendBrainRequest(String path);
void performPinDiagnostic();
void triggerJN5168HardwareReset();

/* --- Hardware Configuration --- */
#define RX2_PIN      16
#define TX2_PIN      17
#define BUTTON_PIN   4       
#define E75_BAUD     500000  

const char* ntpServer = "pool.ntp.org";

/* --- Static Ring Buffer --- */
const int MAX_LOG_LINES = 50;
const int MAX_LINE_LEN = 150; 
char logBuffer[MAX_LOG_LINES][MAX_LINE_LEN];
int logIndex = 0;
bool bufferFull = false;

/* --- SLIP RX Buffer --- */
#define MAX_SLIP_FRAME 512
uint8_t slipRxBuf[MAX_SLIP_FRAME];
int slipRxPtr = 0;
bool isEscaping = false;

/* --- Interlocking and Transaction Tracking --- */
struct OutboundTransaction {
    uint8_t seqNum;
    unsigned long timestamp;
    bool awaitingAck;
    char commandType[16];
};

OutboundTransaction currentTx = {0, 0, false, ""};

uint8_t lockBuf[MAX_SLIP_FRAME];
size_t lockBufLen = 0;
bool commandReady = false;
char pendingService[16] = {0};

/* --- Watchdogs and Keep-Alive --- */
unsigned long lastHeartbeat = 0;
const unsigned long HEARTBEAT_TIMEOUT = 20000; // 20 seconds timeout (4 missed !Z heartbeats)
bool initializationRequired = false;

/* --- State Management --- */
AsyncWebServer server(80);           
AsyncWebServer bridgeServer(8080);   
WiFiUDP udp;

Preferences preferences;

String brainName;
String timezonePosix;
String timezoneName; 
bool debugEnabled = true;
bool triggerShortPress = false;
bool triggerLongPress = false;

const int udpPort = 3201;
IPAddress targetIP(0,0,0,0);
unsigned long lastDiscovery = 0;

uint8_t jennicSeqNum = 0;
#define JN5168_RESET_PIN  18  // RESET-PIN for JN5268

/* --- Neighbor Dump String Cache Sluis --- */
String nbrDumpText = "";

/* --- Runtime Global Dynamisch MAC Adres --- */
uint8_t jnMacAddress[8] = {0x00, 0x15, 0x8D, 0x00, 0x00, 0x00, 0x00, 0x00}; // Default basis, overschreven bij boot


/* --- Core Functions --- */

void addToLog(const char* source, const char* service, const char* msg) {
    struct tm timeinfo;
    char tStr[25]; 
    if(!getLocalTime(&timeinfo)) {
        strcpy(tStr, "[00-00-00 00:00:00]");
    } else {
        strftime(tStr, sizeof(tStr), "[%y-%m-%d %H:%M:%S]", &timeinfo);
    }
    // Alignment: source at 6 chars, service at 11 chars
    snprintf(logBuffer[logIndex], MAX_LINE_LEN, "%s [%-6s] [%-11s] %s", tStr, source, service, msg);
    Serial.println(logBuffer[logIndex]); 
    logIndex = (logIndex + 1) % MAX_LOG_LINES;
    if (logIndex == 0) bufferFull = true;
}

String getFullLog() {
    String output = "";
    output.reserve(udpPort);
    int start = bufferFull ? logIndex : 0;
    int count = bufferFull ? MAX_LOG_LINES : logIndex;
    for (int i = 0; i < count; i++) {
        output += String(logBuffer[(start + i) % MAX_LOG_LINES]) + "\n";
    }
    return output;
}

uint8_t calculateJennicChecksum(const uint8_t* data, size_t len) {
    uint8_t crc = 0x00; // Init = 0x00

    for (size_t i = 0; i < len; i++) {
        // Bit-reversal van de input byte (Reflect In)
        uint8_t in_byte = data[i];
        uint8_t reflected_byte = 0;
        for (uint8_t b = 0; b < 8; b++) {
            if (in_byte & (1 << b)) {
                reflected_byte |= (1 << (7 - b));
            }
        }

        crc ^= reflected_byte;

        // Verwerk de 8 bits met polynoom 0x31
        for (uint8_t bit = 0; bit < 8; bit++) {
            if (crc & 0x80) {
                crc = (crc << 1) ^ 0x31;
            } else {
                crc = (crc << 1);
            }
        }
    }

    // Bit-reversal van het eindresultaat (Reflect Out)
    uint8_t reflected_crc = 0;
    for (uint8_t b = 0; b < 8; b++) {
        if (crc & (1 << b)) {
            reflected_crc |= (1 << (7 - b));
        }
    }

    return reflected_crc; // XOR-out is 0x00, dus direct returnen
}


void escapedWrite(uint8_t data) {
    if (data == 0xC0) {      
        // Found in trace: C0 is converted to 5C 76
        Serial2.write(0x5C);
        Serial2.write(0x76);
    } else if (data == 0x5C) { 
        // trace: 5C is converted to 5C 66
        Serial2.write(0x5C);
        Serial2.write(0x66);
    } else {
        Serial2.write(data);
    }
}

void sendSlipPacket(const uint8_t* data, size_t len) {
    // NOTE: JN5168 does NOT use a start-byte (0xC0), 
    // package starts directly with the data (e.g. 0x21)
    uint8_t csum = calculateJennicChecksum(data, len);

    for (size_t i = 0; i < len; i++) {
        escapedWrite(data[i]);
    }
    escapedWrite(csum);
    Serial2.write(0xC0); // Send an End-of-Frame marker only
}



void processAction(const uint8_t* data, size_t len, const char* source, const char* service) {
    if (len > MAX_SLIP_FRAME) {
        addToLog("sys", "error", "Outbound packet exceeds lock buffer allocation limit");
        return;
    }

    // Capture payload into intermediate sluis buffer instead of writing blind to UART
    memcpy(lockBuf, data, len);
    lockBufLen = len;
    strncpy(pendingService, service, sizeof(pendingService) - 1);
    commandReady = true;

    if (debugEnabled) {
        char logEntry[MAX_LINE_LEN];
        snprintf(logEntry, sizeof(logEntry), "Queued via %s (%d bytes) for execution sluis", source, (int)len);
        addToLog("sys", service, logEntry);
    }
}

void processIncomingJennic(const uint8_t* data, size_t len) {
    if (len < 2) return; 

    const char* type = "unknown";
    char msg[MAX_LINE_LEN];
    memset(msg, 0, MAX_LINE_LEN);

    // 1. Labels found in logs
    if (data[0] == 0x21) { // The '!' prefix
        switch(data[1]) {
            case 0x4D: // 'M' - Management/Blink
                type = "!m (status)";
                if (len >= 10) {
                    // Sla het binnengekomen MAC-adres dynamisch op in de globale array
                    memcpy(jnMacAddress, &data[2], 8);
                }
                snprintf(msg, sizeof(msg), "JN interface ID: %02X:%02X:%02X:%02X:%02X:%02X:%02X:%02X",data[2],data[3],data[4],data[5],data[6],data[7],data[8],data[9] );
                break;

            case 0x52: // 'R'/'r' - Generic Command Acknowledgement Handshake
                type = "!r (ack)";
                if (len >= 3) {
                    uint8_t receivedSeq = data[2];
                    if (currentTx.awaitingAck && currentTx.seqNum == receivedSeq) {
                        currentTx.awaitingAck = false;
                        unsigned long latency = millis() - currentTx.timestamp;
                        if (len >= 6) {
                            snprintf(msg, sizeof(msg), "MATCHED Ack for Seq %02X | Status: %02X %02X | LQI: %02X | Latency: %ldms", data[2], data[3], data[4], data[5], latency);
                        } else {
                            snprintf(msg, sizeof(msg), "MATCHED Ack for Seq %02X (Short Frame) | Latency: %ldms", data[2], latency);
                        }
                    } else {
                        if (len >= 6) {
                            snprintf(msg, sizeof(msg), "ORPHAN/UNTRACKED Ack for Seq %02X | Status: %02X %02X | LQI: %02X", data[2], data[3], data[4], data[5]);
                        } else {
                            snprintf(msg, sizeof(msg), "ORPHAN/UNTRACKED Ack for Seq %02X", data[2]);
                        }
                    }
                }
                break;
                
            case 0x49: // 'I' - Infrared Echo / ACK
                type = "!i (ir-ack)";
                
                // Formatteer de inkomende bytes voor de log (vanaf data[2] om de payload te tonen)
                {
                    char hexBytes[32] = {0};
                    for (size_t j = 2; j < len && j < 8; j++) {
                        char b[4];
                        snprintf(b, sizeof(b), "%02X ", data[j]);
                        strcat(hexBytes, b);
                    }
                    snprintf(msg, sizeof(msg), "IR Data Block Received (%d bytes): %s", (int)len, hexBytes);
                }

                // Sluis-vrijgave op basis van de unieke hardware-handtekening
                // We controleren of de lopende transactie inderdaad een IR-opdracht was
                if (currentTx.awaitingAck && strcmp(currentTx.commandType, "/ir_send") == 0) {
                    
                    // Validatie: Komen de specifieke MAC-bytes (bijv. 08 EA C9) overeen met de ACK?
                    // data[3], data[4], data[5] bevatten de identificerende bytes uit de log
                    if (len >= 6 && 
                        data[3] == jnMacAddress[4] && 
                        data[4] == jnMacAddress[5] && 
                        data[5] == jnMacAddress[6]) {
                        
                        currentTx.awaitingAck = false; // Sluis direct vrijgeven!
                        unsigned long latency = millis() - currentTx.timestamp;
                        
                        // Plak de succesvolle ontgrendeling aan het logbericht
                        strcat(msg, " | MATCHED IR-ACK -> Sluis vrijgegeven");
                    }
                }
                break;

            case 0x4C: // 'L' - LED ack
                type = "!L (led-ack)";
                snprintf(msg, sizeof(msg), "Led acq Received (%d bytes)", (int)len);
                break;

            case 0x5a: // 'Z' - Heartbeat from JN5168 (every 5 seconds)
                 lastHeartbeat = millis(); // Refresh keep-alive watchdog timer
                 return;                   // return directly so that we do not print the heartbeat records
                break;

        }
    } 
    else if (data[0] == 0x49) { // 'I' (Inbound from Node)
        type = "incoming pairing";
        snprintf(msg, sizeof(msg), "Node Data (NBR) | Seq: %02X | Node: %02X:%02X:%02X:%02X:%02X:%02X", data[2], data[7], data[8], data[9], data[10], data[11], data[12], data[13], data[14]);
    }
    else if (data[0] == 0x69 && data[1] == 0xDC) { // 'id' (Neighbor Dump)
        type = "nbr-dump";
        snprintf(msg, sizeof(msg), "Full Neighbor Table Dump (%d bytes)", (int)len);
        
        // Clear old text cache
        nbrDumpText = "";
        
        // Loop through the data to parse potential neighbor nodes (each node record is roughly 14-16 bytes)
        size_t idx = 3; // Skip 69 DC and SeqNum
        while (idx + 10 <= len) {
            char nodeLine[64];
            snprintf(nodeLine, sizeof(nodeLine), "id:%02X%02X%02X%02X%02X%02X%02X%02X,short:%02X%02X\n",
                     data[idx], data[idx+1], data[idx+2], data[idx+3],
                     data[idx+4], data[idx+5], data[idx+6], data[idx+7],
                     data[idx+8], data[idx+9]);
            nbrDumpText += nodeLine;
            idx += 14; 
        }
    }

    // 2. XML/ASCII Scanner for TR2 Provisioning (if exists in data)
    String readable = "";
    for (size_t i = 0; i < len; i++) {
        if (data[i] >= 32 && data[i] <= 126) readable += (char)data[i];
    }
    
    // If readable XML-data found, add this to message
    if (readable.indexOf("gui_xml") != -1) {
        readable.replace("&#x2F;", "/");
        snprintf(msg, sizeof(msg), "TR2 REQ: %s", readable.substring(0, 100).c_str());
    }

    // 3. Fallback to Hex if msg is still empty (unknown records)
    if (strlen(msg) == 0) {
        char hexBuf[50] = {0};
        for(size_t j=0; j<len && j<15; j++) {
            char b[4]; snprintf(b, 4, "%02X ", data[j]); strcat(hexBuf, b);
        }
        snprintf(msg, sizeof(msg), "HEX: %s", hexBuf);
    }
    
    addToLog("jn5168", type, msg);
}


void sendBrainRequest(String path) {
    if (WiFi.status() == WL_CONNECTED && targetIP.toString() != "0.0.0.0") {
        HTTPClient http;
        String url = "http://" + targetIP.toString() + ":3000" + path;
        http.begin(url);
        int httpCode = http.GET();
        
        char logMsg[100];
        snprintf(logMsg, sizeof(logMsg), "REQ -> %s (Code: %d)", path.c_str(), httpCode);
        addToLog("http", "brain", logMsg);
        http.end();
        
        if (httpCode < 0) targetIP = IPAddress(0,0,0,0);
    }
}

void performPinDiagnostic() {
    addToLog("diag", "sequence", "Starting Pin-Check sequence");
    uint8_t c1 = 0x11; processAction(&c1, 1, "diag", "/led_red"); delay(500); 
    uint8_t c2 = 0x21; processAction(&c2, 1, "diag", "/led_white"); delay(500); 
    uint8_t dummyIR[] = {'!', 'I', 0x94, 0x70, 0x01, 0x00, 0x05, 'E'};
    processAction(dummyIR, sizeof(dummyIR), "diag", "/ir_test"); delay(500); 
    uint8_t c0 = 0x00; processAction(&c0, 1, "diag", "/led_off");
}

 void handleIRRequest(AsyncWebServerRequest *request) {
    uint16_t vals[150]; 
    int count = 0;
    uint16_t freq = 38000; 
    bool isPost = request->hasParam("s", true);
    if (request->hasParam("s") || isPost) {
        String pulseData = request->getParam("s", isPost)->value();
        pulseData.replace('.', ','); 
        
        if (request->hasParam("f", isPost)) {
            freq = (uint16_t)request->getParam("f", isPost)->value().toInt();
        }

        int lastPos = 0, nextPos = 0;
        while ((nextPos = pulseData.indexOf(',', lastPos)) != -1 && count < 150) {
            vals[count++] = (uint16_t)pulseData.substring(lastPos, nextPos).toInt();
            lastPos = nextPos + 1;
        }
        vals[count++] = (uint16_t)pulseData.substring(lastPos).toInt();

        size_t pSize = 12 + (count * 2); 
        uint8_t* irBuf = (uint8_t*)malloc(pSize);
        
        if(irBuf) {
            memset(irBuf, 0, pSize);
            irBuf[0] = 0x21; irBuf[1] = 0x49; // !I
            irBuf[4] = (uint8_t)(freq >> 8);   
            irBuf[5] = (uint8_t)(freq & 0xFF); 
            irBuf[9] = 0x04;                   
            irBuf[11] = 0x01;                  

            int pIdx = 12;
            for (int i = 0; i < count; i++) {
                irBuf[pIdx++] = (uint8_t)(vals[i] >> 8);   
                irBuf[pIdx++] = (uint8_t)(vals[i] & 0xFF); 
            }

            processAction(irBuf, pIdx, "web", "/ir_send");
            free(irBuf);
            request->send(200, "text/plain", "OK");
        } else {
            request->send(500, "text/plain", "Memory allocation failed");
        }
    } else {
        request->send(400, "text/plain", "Missing pulses 's'");
    }
}



void HandleBlinkCommand(AsyncWebServerRequest *request, const char* source, const char* pC) {
    // command based on UART-log: 21 4d [01 or 00]
    uint8_t modeVal = 0x00; 
    if (request->hasParam("mode")) {
        String m = request->getParam("mode")->value();
        if (m == "on" || m == "1") modeVal = 0x01; // Conform data: 21 4d 01
    }    
    uint8_t blinkPkg[3] = {0x21, 0x4d, modeVal};
    processAction(blinkPkg, 3, source, pC);
    request->send(200, "text/plain", "Blink sent");
}

void HandleNBRCommand(AsyncWebServerRequest *request, const char* source, const char* pC) {
    // Format from strace: 21 (SOF) 53 (Send) [Seq]
    uint8_t nbrPkg[3] = {0x21, 0x53, jennicSeqNum++}; 
    processAction(nbrPkg, 3, source, pC);
    
    // Return the text-based table rows matching what the Brain string-parser expects
    if (nbrDumpText.length() > 0) {
        request->send(200, "text/plain", nbrDumpText);
    } else {
        request->send(200, "text/plain", "NBR Query sent, awaiting cache filling");
    }
}


void HandleDiscoCommand(AsyncWebServerRequest *request, const char* source, const char* pC) {
    // Based on trace: 21 5a a0 is the heartbeat of the chip, 
    // activation via Send (53) + seqnumber + payload.
    uint8_t discPkg[] = {0x21, 0x53, jennicSeqNum++, 0x00, 0x04, 0x09, 0x00, 0x03, 0x0a, 0x00, 0x2a, 0x0b, 0x00, 0x01, 0x0e, 0x00, 0x01, 0x41, 0xd8, 0x2a, 0xcd, 0xab, 0xff, 0xff, 0x38, 0x9c, 0xcd, 0x00, 0x00, 0x8d, 0x15, 0x00, 0x7a, 0x3b, 0x3a, 0x1a, 0x9b, 0x01, 0x47, 0x6f, 0x1e, 0xf0, 0x01, 0x00, 0x10, 0xf0, 0x00, 0x00, 0xfd, 0xa1, 0x68, 0x4a, 0x36, 0xca, 0x00, 0x00, 0x02, 0x15, 0x8d, 0x00, 0x00, 0xcd, 0x9c, 0x38, 0x04, 0x0e, 0x00, 0x17, 0x08, 0x0a, 0x07, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x1e, 0x00, 0x3c, 0x08, 0x1e, 0x40, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xfd, 0xa1, 0x68, 0x4a, 0x36, 0xca, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
        //0xA0}; 
    addToLog("8080", "Discovery", "");

    uint8_t send_L[] = {0x21, 0x4C, 0x05};  // Blink led?

    sendSlipPacket(send_L, sizeof(send_L));
    delay(100);
    uint8_t send_2[] = {0x21, 0x4D, 0x00}; // !M // Set pairing??

    sendSlipPacket(send_2, sizeof(send_2));
    delay(1000);

    //processAction(discPkg, 4, source, pC);
    request->send(200, "text/plain", "Discovery mode activated");
    // 4b
    // 43
    // 4d
}


void HandleEncryptionCommand(AsyncWebServerRequest *request, const char* source, const char* pC) {
    uint8_t keyPkg[18];
    keyPkg[0] = 0x21; // '!'
    keyPkg[1] = 0x4B; // 'K' (Key)

    // If key is passed via parameter 'k' (hex string), convert to bytes, else default:
    if (request->hasParam("k")) {
        String hexKey = request->getParam("k")->value();
        size_t hexLen = hexKey.length();
        uint8_t dynamicKey[16] = {0};
        
        // Parse hex string characters into raw bytes
        for (size_t i = 0; i < hexLen && i < 32; i += 2) {
            char byteString[3] = { hexKey[i], hexKey[i+1], '\0' };
            dynamicKey[i / 2] = (uint8_t)strtol(byteString, NULL, 16);
        }
        memcpy(&keyPkg[2], dynamicKey, 16);
    } else {
        // Default NEEO test-key from log
        uint8_t defaultKey[] = {0x77, 0x59, 0x7a, 0x6c, 0x91, 0x7c, 0x49, 0x78, 0x97, 0x7b, 0x4b, 0x38, 0x95, 0xb8, 0xfb, 0x80};
        memcpy(&keyPkg[2], defaultKey, 16);
    }
    addToLog("8080", "Encrypytion", "");

    processAction(keyPkg, 18, source, pC);
    request->send(200, "text/plain", "Airkey pushed to JN5168");

}

void handleUnifiedCommand(AsyncWebServerRequest *request, const char* source) {
    String path = request->url();
    const char* pC = path.c_str();
    if (path.indexOf("/blink") != -1) 
        HandleBlinkCommand(request, source,  pC);
    else if (path.indexOf("/neighbors") != -1) 
        HandleNBRCommand(request, source,  pC);
    else if (path.indexOf("/discovery") != -1) 
        HandleDiscoCommand(request, source,  pC);
    else if (path.indexOf("/encryption") != -1) 
        HandleEncryptionCommand(request, source,  pC);
    else if (path.indexOf("/diag") != -1) { 
        performPinDiagnostic(); 
        request->send(200); 
    }
    else if (path.indexOf("/stats") != -1) {
        if (nbrDumpText.length() > 0) {
            request->send(200, "text/plain", nbrDumpText);
        } else {
            request->send(200, "application/json", "{\"status\":\"ok\",\"value\":66}"); 
        }
    }
    else if (path.indexOf("/ShortPress") != -1) {
        triggerShortPress = true; // Set flag only
        request->send(200, "text/plain", "Triggered");
    }
    else if (path.indexOf("/LongPress") != -1) { 
        triggerLongPress = true; // Set flag only
        request->send(200, "text/plain", "Triggered");
    }
}

void triggerJN5168HardwareReset() {
    addToLog("sys", "hardware", "Executing physical pin-reset sequence on JN5168");
    digitalWrite(JN5168_RESET_PIN, LOW);
    delay(100); 
    digitalWrite(JN5168_RESET_PIN, HIGH);
    
    // Arm the flag to cleanly redeploy settings inside the main loop thread safely
    initializationRequired = true;
    lastHeartbeat = millis(); // Refresh watchdog boundary to prevent loop racing
}

void setup() {
    // --- Hardware Reset for JN5168 ---
    pinMode(JN5168_RESET_PIN, OUTPUT);
    digitalWrite(JN5168_RESET_PIN, LOW);
    delay(100); // Hold reset low
    digitalWrite(JN5168_RESET_PIN, HIGH);
    delay(200); // Allow time for boot initialization
    
    lastHeartbeat = millis(); // Initialize keep-alive baseline tracking

    btStop();
    esp_bt_controller_disable();
    Serial.begin(115200); 
    Serial2.begin(E75_BAUD, SERIAL_8N1, RX2_PIN, TX2_PIN);
    
    preferences.begin("neeo", false);
    brainName = preferences.getString("brain_name", "neeo");
    timezonePosix = preferences.getString("tz_info", "CET-1CEST,M3.5.0,M10.5.0/3");
    timezoneName = preferences.getString("tz_name", "");
    debugEnabled = preferences.getBool("debug_logs", true); 
    preferences.end();
    
    connectWiFi(); 
    configTime(0, 0, ntpServer);     
    setenv("TZ", timezonePosix.c_str(), 1); 
    tzset();
    
    udp.begin(udpPort);
    if (MDNS.begin((brainName + "-jn5168").c_str())) {
        MDNS.addService("http", "tcp", 80);
    }

    auto sharedHandler = [](AsyncWebServerRequest *request) {
        if (request->client()->localPort() == 8080 && targetIP == IPAddress(0,0,0,0)) {
            targetIP = request->client()->remoteIP();           
            String msg = "First Bridge Call! TargetIP set to: " + targetIP.toString();
            addToLog("sys", "bridge_init", msg.c_str());
        }
        const char* source = (request->client()->localPort() == 8080) ? "p_8080" : "p_80";
        handleUnifiedCommand(request, source);
    };

server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
    String html = String(FPSTR(INDEX_HTML));

    html.replace("[[BRAIN]]", brainName);
    html.replace("[[POSIX]]", timezonePosix);
    html.replace("[[TZNAME]]", timezoneName);
    html.replace("[[DEBUG_CHECKED]]", debugEnabled ? "checked" : "");
    html.replace("[[LOG_CONTENT]]", getFullLog());
    html.replace("[[WIFI_SSID]]", WiFi.SSID());

    request->send(200, "text/html", html);
});
    server.on("/blink", HTTP_ANY, sharedHandler);
    bridgeServer.on("/blink", HTTP_ANY, sharedHandler);
    server.on("/neighbors", HTTP_ANY, sharedHandler);
    bridgeServer.on("/neighbors", HTTP_ANY, sharedHandler);
    bridgeServer.on("/stats", HTTP_ANY, sharedHandler);
    server.on("/discovery", HTTP_ANY, sharedHandler);
    bridgeServer.on("/discovery", HTTP_ANY, sharedHandler);
    server.on("/encryption", HTTP_ANY, sharedHandler);
    bridgeServer.on("/encryption", HTTP_ANY, sharedHandler);
    server.on("/diag", HTTP_ANY, sharedHandler);
    server.on("/ShortPress", HTTP_ANY, sharedHandler);
    server.on("/LongPress", HTTP_ANY, sharedHandler);
    bridgeServer.on("/sendir", HTTP_ANY, handleIRRequest);
    server.on("/v1/api/ir", HTTP_POST, handleIRRequest);

    // Log endpoint for automatic refresh
    server.on("/log", HTTP_GET, [](AsyncWebServerRequest *request){
        request->send(200, "text/plain", getFullLog());
    });

    // Save settings
    server.on("/save", HTTP_POST, [](AsyncWebServerRequest *request){
        if(request->hasParam("brain", true)) brainName = request->getParam("brain", true)->value();
        if(request->hasParam("tz_posix", true)) timezonePosix = request->getParam("tz_posix", true)->value();
        if(request->hasParam("tz_name", true)) timezoneName = request->getParam("tz_name", true)->value();
        debugEnabled = request->hasParam("debug", true);

        preferences.begin("neeo", false);
        preferences.putString("brain_name", brainName);
        preferences.putString("tz_info", timezonePosix);
        preferences.putString("tz_name", timezoneName);
        preferences.putBool("debug_logs", debugEnabled);
        preferences.end();

        request->send(200, "text/html", "Settings Saved. Restarting... <meta http-equiv='refresh' content='2;url=/'>");
        delay(1000);
        ESP.restart();
    });

    // Clear log
    server.on("/clearlog", HTTP_ANY, [](AsyncWebServerRequest *request){
        logIndex = 0;
        bufferFull = false;
        for(int i=0; i<MAX_LOG_LINES; i++) memset(logBuffer[i], 0, MAX_LINE_LEN);
        request->send(200);
    });

    // WiFi Reset
    server.on("/reset_wifi", HTTP_POST, [](AsyncWebServerRequest *request){
        request->send(200, "text/plain", "Resetting WiFi and Restarting...");
        delay(1000);
        WiFiManager wm;
        wm.resetSettings();
        ESP.restart();
    });

    server.onNotFound([](AsyncWebServerRequest *request) {
        addToLog("GUI", "404", request->url().c_str());
        request->send(404, "text/plain", "Not found");
    });

    bridgeServer.onNotFound([](AsyncWebServerRequest *request) {
        addToLog("8080", "404", request->url().c_str());
        request->send(404, "text/plain", "Not found");
    });    

    server.begin();
    bridgeServer.begin();
    addToLog("sys", "boot", "Dual Port Server Ready");

    // Trigger full deployment sequence to synchronize peripherals immediately on boot
    initializationRequired = true;
}

void loop() {
    // --- 1. SERIAL PROCESSING (JN5168 HDLC/PPP Protocol) ---
    while (Serial2.available()) {
        uint8_t c = Serial2.read();

        if (c == 0xC0) { // End of Frame
            if (slipRxPtr > 0) {
                processIncomingJennic(slipRxBuf, slipRxPtr);
                slipRxPtr = 0; // Reset for next packet
            }
            isEscaping = false; // Reset escape status when frame-end
        } 
        else if (c == 0x5C) { // escape-character '\'
                isEscaping = true;
             } 
             else {
                if (isEscaping) {
                    if (c == 0x76) c = 0xC0;      // 5C 76 -> C0
                    else if (c == 0x66) c = 0x5C; // 5C 66 -> 5C
                    isEscaping = false;
                }
                if (slipRxPtr < MAX_SLIP_FRAME) {
                    slipRxBuf[slipRxPtr++] = c;
                } else {
                    // Prevent deadlocks from noise overflow; drop corrupted buffer frame
                    slipRxPtr = 0;
                    isEscaping = false;
                    addToLog("sys", "serial_err", "SLIP Rx Frame Overflow Dropped");
                }
            }
    }

    // --- 2. COMMAND SLUIS INTERLOCKING CONTROLLER ---
    if (commandReady && !currentTx.awaitingAck) {
        commandReady = false; // Consume structural event trigger

        // Scan frame parameters to parse transaction sequence if tracked command
        if (lockBufLen >= 3 && lockBuf[0] == 0x21 && (lockBuf[1] == 0x53 || lockBuf[1] == 0x4D || lockBuf[1] == 0x43 ||/* lockBuf[1] == 0x4B ||*/ lockBuf[1] == 0x49)) {
            currentTx.seqNum = lockBuf[2];
            currentTx.timestamp = millis();
            currentTx.awaitingAck = true;
            strncpy(currentTx.commandType, pendingService, sizeof(currentTx.commandType) - 1);
            
            if (debugEnabled) {
                char logEntry[64];
                snprintf(logEntry, sizeof(logEntry), "Tracking Tx Seq %02X for service %s", currentTx.seqNum, currentTx.commandType);
                addToLog("sys", "sluis", logEntry);
            }
        }

        // Physically clock binaire frame onto the UART link
        sendSlipPacket(lockBuf, lockBufLen);

        if (debugEnabled) {
            char hexData[100] = {0};
            for(size_t i = 0; i < lockBufLen && i < 20; i++) {
                char buf[5];
                snprintf(buf, sizeof(buf), "%02X ", lockBuf[i]);
                strcat(hexData, buf);
            }
            char logEntry[MAX_LINE_LEN];
            snprintf(logEntry, sizeof(logEntry), "Sent via sluis (%d bytes) HEX: %s", (int)lockBufLen, hexData);
            addToLog("jn5168", pendingService, logEntry);
        }
    }

    // --- 3. TRANSACTION TIMEOUT MONITORING WATCHDOG ---
    if (currentTx.awaitingAck && (millis() - currentTx.timestamp > 500)) {
        char errEntry[128];
        snprintf(errEntry, sizeof(errEntry), "TIMEOUT waiting for !r ACK on Seq %02X (Service: %s) - Force freeing sluis", currentTx.seqNum, currentTx.commandType);
        addToLog("sys", "error", errEntry);
        
        currentTx.awaitingAck = false; // Discard un-acknowledged transaction block to unblock execution queue
    }

    // --- 4. JN5168 KEEP-ALIVE WATCHDOG (!Z MONITOR) ---
    if (millis() - lastHeartbeat > HEARTBEAT_TIMEOUT) {
        addToLog("sys", "error", "JN5168 Heartbeat (!Z) missing for 20s! Radio link dead.");
        triggerJN5168HardwareReset();
    }

    // --- 5. DEFERRED INITIALIZATION PROTOCOL DEPLOYMENT ---
    if (initializationRequired && !commandReady && !currentTx.awaitingAck) {
        initializationRequired = false;
        addToLog("sys", "init", "Deploying JN5168 initialization sequence parameters");

        // Step 1: Request MAC address (?M / 3f 4d)
        uint8_t cmdGetMac[] = {0x3F, 0x4D};
        Serial2.write(0xC0); // Alert jn5168 of this first transmission

        sendSlipPacket(cmdGetMac, sizeof(cmdGetMac));
        delay(100);

        // Step 2: Set configuration to PAN Coordinator (!C with payload 0d)
        uint8_t cmdSetConfig[] = {0x21, 0x43, 0x0D};
        sendSlipPacket(cmdSetConfig, sizeof(cmdSetConfig));
        delay(100);


        // Step 3: Channel and Network initialization (!K with bitmask/config string from logs)
        //uint8_t cmdInitNetwork[] = {0x21, 0x4B, 0x77, 0x59, 0x7A, 0x6C, 0x9D};
        uint8_t cmdInitNetwork[] = {0x21, 0x4B, 0x77, 0x59, 0x7a, 0x6c, 0x91, 0x7c, 0x49, 0x78, 0x97, 0x7b, 0x4b, 0x38, 0x95, 0xb8, 0xfb, 0x80};
        sendSlipPacket(cmdInitNetwork, sizeof(cmdInitNetwork));
        delay(100);

        // Step 4: Activation phase / Mode confirmation (!M with parameter 01)
        uint8_t cmdActivateRadio[] = {0x21, 0x4D, 0x01};
        sendSlipPacket(cmdActivateRadio, sizeof(cmdActivateRadio));        
    }

    // --- 6. UDP DISCOVERY (Searching for the Brain) ---
    if (WiFi.status() == WL_CONNECTED && targetIP.toString() == "0.0.0.0") {
        if (millis() - lastDiscovery > 5000) { 
            lastDiscovery = millis();
            String Up_BrainName = brainName;
            Up_BrainName.toUpperCase();
            String LookFor = "WHO_IS_NEEO->" + Up_BrainName;
            addToLog("sys", "Get_BrainIP", LookFor.c_str() );
            udp.beginPacket("255.255.255.255", udpPort);
            udp.print("WHO_IS_NEEO->" + Up_BrainName);
            udp.endPacket();
        }
    }

    // Listen for response from Brain
    if (WiFi.status() == WL_CONNECTED) {
        int packetSize = udp.parsePacket();
        if (packetSize) {
            char reply[32];
            int len = udp.read(reply, sizeof(reply) - 1);
            if (len > 0) {
                reply[len] = 0;
                if (String(reply).indexOf("I_AM_NEEO") != -1) {
                    targetIP = udp.remoteIP();
                    String msg = "Brain responded: " + targetIP.toString();
                    addToLog("sys", "Find_Brain", msg.c_str());
                }
            }
        }
    }

    // Here we execute commands that are "deferred execute", as they need to be done outside handlers (in normal loop, to prevent watchdog crashes)
    if (triggerShortPress) {
        triggerShortPress = false;
        if (targetIP.toString() != "0.0.0.0") {
            sendBrainRequest("/v1/api/TouchButton");
        } else {
            addToLog("http", "error", "No Brain IP; action cancelled");
        }
    }

    if (triggerLongPress) {
        triggerLongPress = false;
        if (targetIP.toString() != "0.0.0.0") {
            sendBrainRequest("/v1/api/longTouchButton");
        } else {
            addToLog("http", "error", "No Brain IP; action cancelled");
        }
    }
}